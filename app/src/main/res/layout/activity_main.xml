<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFE4F1" 
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Jo's\n- Mi Amor -"
        android:textAlignment="center"
        android:textColor="#5E35B1"
        android:textSize="32sp"
        android:textStyle="bold|italic"
        android:fontFamily="serif"
        android:layout_marginBottom="32dp"/>

    <ImageView
        android:layout_width="250dp"
        android:layout_height="300dp"
        android:src="@drawable/b20" 
        android:scaleType="fitCenter"
        android:layout_marginBottom="32dp"
        android:contentDescription="Splash Bouquet"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Flower Shop"
        android:textColor="#5E35B1"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="“Bloom with love, delivered with care”"
        android:textAlignment="center"
        android:textColor="#5E35B1"
        android:textSize="16sp"
        android:textStyle="italic"
        android:layout_marginBottom="48dp"/>

    <Button
        android:id="@+id/btn_get_started"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Get Started"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:background="@drawable/pill_button_bg" 
        android:textAllCaps="false"
        android:layout_marginHorizontal="16dp"/>

</LinearLayout>